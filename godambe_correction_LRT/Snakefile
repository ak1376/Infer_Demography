# godambe_correction_LRT/Snakefile
#
# Per-arm Moments-LD + Godambe-J block-size sweep for the real Drosophila arms,
# PLUS the validated-block-size / uncorrelated-distance histogram analysis
# (the productionized version of building_bridges.py). No high-recombination
# masking anywhere -- everything runs on the raw, unmasked arm VCFs.
# Maximally parallelized: every LHS optimization and every window is its own job.
# Run from the repo ROOT:
#     snakemake -s godambe_correction_LRT/Snakefile --cores N --resources gpu=G <target>
#
# Per arm:
#   1. genetic_map                                       (Comeron xlsx -> cM map)
#   2. validated_blocks: per-300kb-chunk, per-population (CO/FR) LD-decay ->
#        floor -> crossing distance -> CO/FR histograms + a validated block size,
#        directly validated against the EXACT literal blocks used downstream
#   3. OVERLAPPING windows -> fit SIMPLE model -> p0
#        fit is 100 LHS starts, EACH ITS OWN JOB (fit_one_start) -> collect_best_fit
#   4. NON-OVERLAPPING windows (per block size), embed p0 in the complex model
#        tiling is a checkpoint; each window's LD stats is its own job
#   5. J vs block size -> per-arm plot
#
# rule all currently targets ONLY the validated_blocks histogram (step 2) for
# ACTIVE_ARMS -- the moments/LD-Godambe sweep (steps 3-5) still works, just
# request its target explicitly (see rule sweep_plot).

import os
from pathlib import Path

# ---------------------------------------------------------------------------
# Paths (relative to repo root)
# ---------------------------------------------------------------------------
DROSO         = "real_data_analysis/data/drosophila"
COMERON_XLSX  = f"{DROSO}/recombination_maps/Comeron_100kb_R5_R6.xlsx"
POPFILE       = f"{DROSO}/popfile.txt"
def arm_vcf(arm):
    return f"{DROSO}/{arm}/polarized.diploidGT.vcf.gz"

OUT           = "godambe_correction_LRT/real_arms"
GODAMBE_SCR   = "godambe_correction_LRT/scripts"
SNAKE_SCR     = "snakemake_scripts"
LD_CONFIG     = "godambe_correction_LRT/ld/ld_config.json"   # num_samples + use_gpu_ld

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------
ARMS = ["Chr2L", "Chr2R", "Chr3L", "Chr3R"]

# Per-arm NON-overlapping block sizes (bp) for the J sweep. Chr2L extended down
# to 20 kb (~ the containment floor for these r_bins) to look for a small-block
# plateau. Other arms start at 50 kb.
_SWEEP = [20_000, 30_000, 40_000, 50_000, 100_000, 200_000, 500_000]
BLOCKSIZES = {arm: list(_SWEEP) for arm in ARMS}

R_BINS = "0,1e-6,2e-6,5e-6,1e-5,2e-5"            # trimmed r_bins

OVERLAP_WINDOW  = 1_000_000                       # step 3 overlapping windows
OVERLAP_NWIN    = 100
OVERLAP_WINDOWS = range(OVERLAP_NWIN)

N_OPT       = 100                                 # LHS starts for the fit
OPT_INDICES = range(N_OPT)

# The same fit rules serve both models, selected by the {fit} wildcard:
#   fit_simple/  -> null  (split_migration_growth,      CO constant, p0 for J)
#   fit_complex/ -> alt   (split_migration_growth_both, CO grows)
FIT_MODEL = {
    "simple":  "split_migration_growth",         # original null (free N_CO)
    "complex": "split_migration_growth_both",     # original alt  (free N_CO0 & N_CO1 -- unidentifiable)
}

# Per-arm SFS (moments) identifiability check -- mirrors the LD-side Godambe
# conditioning diagnostic (run_lrt.py cond(H)), but for the theta-profiled
# scaled-ratio real-data moments fit (src.moments_inference_real). Reuses the
# same fitting engine as the root Snakefile's rule infer_moments_real; this is
# NOT a duplicate demographic-model definition, just a per-arm entry point +
# the FIM/railing diagnostic that doesn't exist yet for the real-data branch.
SFS_CFG = {
    "simple":  "config_files/experiment_config_split_migration_growth.json",
    "complex": "config_files/experiment_config_split_migration_growth_both.json",
}
SFS_N_STARTS = 100

# Godambe-adjusted LRT for CO growth (scripts/godambe_lrt_growth.py), generalized
# from the original Chr3L-only bootstrapping_for_LRT_Chr3L.py so any arm in
# SFS_ARMS can be requested directly. ~100 kb is the LD-justified recommendation
# from bootstrap_window_size.py (set by the slow-decaying Chr2R-FR curve in the
# pooled analysis); the arm-specific, LD-decay-validated block size from
# rule validated_blocks is reported alongside this sweep, not instead of it.
GODAMBE_GROWTH_BLOCK_SIZES_KB = [50, 75, 100, 150, 200, 300, 500]
GODAMBE_GROWTH_NUM_BOOT_REPS = 10_000

ACTIVE_ARMS = ["Chr3L"]                           # restricted to Chr3L for now

wildcard_constraints:
    arm         = r"Chr[0-9A-Za-z]+",
    fit         = r"simple|complex",
    opt         = r"\d+",
    i           = r"\d+",
    blocksize   = r"\d+",
    chunk_index = r"\d+",


def blocksizes_for(arm):
    return BLOCKSIZES[arm]


# ---------------------------------------------------------------------------
# Targets
# ---------------------------------------------------------------------------
rule all:
    input:
        expand(f"{OUT}/{{arm}}/validated_blocks_histogram.png", arm=ACTIVE_ARMS),


# ===========================================================================
# STEP 1 -- genetic map
# ===========================================================================
rule genetic_map:
    input:
        xlsx = COMERON_XLSX,
    output:
        gmap = f"{OUT}/{{arm}}/genetic_map.txt",
    shell:
        r"""
        set -euo pipefail
        python "{SNAKE_SCR}/build_genetic_map.py" \
            --xlsx "{input.xlsx}" --chrom "{wildcards.arm}" --out "{output.gmap}"
        """

# ===========================================================================
# STEP 2 -- VALIDATED BLOCK SIZE / uncorrelated-distance histograms
# (productionized building_bridges.py). Per-population (CO/FR), per-300kb-chunk
# LD-decay -> floor -> crossing (uncorrelated) distance; combines across chunks
# into a validated block size and saves the CO/FR crossing-distance histograms
# (see compute_validated_blocks.py). Validates that exact, literal block list
# directly (validate_blocks_direct), not a re-derived local approximation.
# Runs on the RAW, UNMASKED arm VCF -- its whole job is to discover the
# usable/unusable boundary itself, so it can't be pre-restricted to a region.
# Part of `rule all`.
# ===========================================================================
rule validated_blocks:
    input:
        vcf     = lambda wc: arm_vcf(wc.arm),
        popfile = POPFILE,
    output:
        bed            = f"{OUT}/{{arm}}/validated_blocks.bed",
        report         = f"{OUT}/{{arm}}/validated_blocks_report.json",
        histogram      = f"{OUT}/{{arm}}/validated_blocks_histogram.png",
        crossr2_check  = f"{OUT}/{{arm}}/validated_blocks_crossr2_check.png",
    resources:
        gpu = 1
    params:
        script = f"{GODAMBE_SCR}/compute_validated_blocks.py",
    shell:
        r"""
        set -euo pipefail
        python "{params.script}" \
            --vcf "{input.vcf}" --popfile "{input.popfile}" --arm "{wildcards.arm}" \
            --out-bed "{output.bed}" --out-report "{output.report}" \
            --out-histogram "{output.histogram}" \
            --out-crossr2-check "{output.crossr2_check}"
        """

# Visual check: does correlation actually drop off at the validated block
# boundaries? Renders the raw r2 matrix (black & white, CO vs FR) for ONE
# 300kb chunk -- the same chunk unit compute_validated_blocks.py used to
# compute that chunk's floor/crossing distance -- with the block-tiling
# boundaries drawn as dashed lines. Not part of `rule all`; NOTE: this
# snakemake version has a logging bug that raises a spurious "not enough
# values to unpack" in the default (non-verbose) log level for this rule --
# always pass --verbose when requesting it, e.g.:
#   snakemake -s godambe_correction_LRT/Snakefile --cores N --resources gpu=G \
#       --verbose godambe_correction_LRT/real_arms/Chr3L/ld_chunk_zoom_c0.png
rule ld_chunk_zoom:
    input:
        vcf   = lambda wc: arm_vcf(wc.arm),
        popfile = POPFILE,
        bed   = f"{OUT}/{{arm}}/validated_blocks.bed",
    output:
        png = f"{OUT}/{{arm}}/ld_chunk_zoom_c{{chunk_index}}.png",
    resources:
        gpu = 1
    params:
        script = f"{GODAMBE_SCR}/plot_ld_blocks_zoom.py",
    shell:
        r"""
        set -euo pipefail
        python "{params.script}" \
            --vcf "{input.vcf}" --popfile "{input.popfile}" --arm "{wildcards.arm}" \
            --blocks-bed "{input.bed}" \
            --chunk-index {wildcards.chunk_index} \
            --out-png "{output.png}"
        """


# Tile the raw haploid polarized VCF into non-overlapping blocks of a given
# physical size (bp), for block-bootstrap resampling (mirrors `checkpoint
# tile_nonoverlap` below, which does the same thing for the diploid VCF used
# by the moments.LD/J side; this one uses the haploid VCF used by the
# LD-decay/SFS side instead).
# CHECKPOINT: the number of blocks is only known at runtime (span // blocksize).
# Request a size explicitly, e.g.:
#   snakemake -s godambe_correction_LRT/Snakefile --cores N \
#       godambe_correction_LRT/real_arms/Chr3L/blocks/bs20000/windows
checkpoint tile_polarized_blocks:
    input:
        vcf     = f"{DROSO}/{{arm}}/polarized.vcf.gz",
        popfile = POPFILE,
    output:
        windir = directory(f"{OUT}/{{arm}}/blocks/bs{{blocksize}}/windows"),
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{output.windir}"
        # `bcftools query | head` trips SIGPIPE under pipefail; disable it here.
        set +o pipefail
        first=$(bcftools query -f '%POS\n' "{input.vcf}" | head -n1)
        last=$(bcftools query -f '%POS\n' "{input.vcf}" | tail -n1)
        set -o pipefail
        span=$((last - first + 1))
        n=$((span / {wildcards.blocksize}))
        if [ "$n" -lt 1 ]; then n=1; fi
        python "{SNAKE_SCR}/split_vcf_windows.py" \
            --input-vcf "{input.vcf}" --popfile "{input.popfile}" \
            --out-dir "{output.windir}" \
            --window-size {wildcards.blocksize} --num-windows "$n"
        """

# gather the block VCFs after the tiling checkpoint resolves (mirrors
# gather_ld_pkls below, for the moments.LD/J side's own checkpoint)
def gather_block_vcfs(wildcards):
    ck = checkpoints.tile_polarized_blocks.get(arm=wildcards.arm, blocksize=wildcards.blocksize)
    windir = ck.output.windir
    idxs = glob_wildcards(os.path.join(windir, "window_{i}.vcf.gz")).i
    pattern = OUT + "/{arm}/blocks/bs{blocksize}/windows/window_{i}.vcf.gz"
    return expand(pattern, arm=wildcards.arm, blocksize=wildcards.blocksize, i=idxs)

# Raw Godambe H and J for the CO-growth test, at one arm + block size, using
# moments.Godambe's own internals (see compute_H_J.py) rather than a
# hand-rolled score/J loop. Not part of `rule all`; request explicitly, e.g.:
#   snakemake -s godambe_correction_LRT/Snakefile --cores N \
#       godambe_correction_LRT/real_arms/Chr3L/blocks/bs20000/H_J.json
rule compute_H_J:
    input:
        block_vcfs  = gather_block_vcfs,
        sfs         = f"{DROSO}/{{arm}}/unfolded.sfs.pkl",
        simple_fit  = f"{OUT}/{{arm}}/sfs_fit_simple/best_fit.pkl",
        complex_fit = f"{OUT}/{{arm}}/sfs_fit_complex/best_fit.pkl",
        popfile     = POPFILE,
    output:
        json = f"{OUT}/{{arm}}/blocks/bs{{blocksize}}/H_J.json",
    params:
        script = f"{GODAMBE_SCR}/compute_H_J.py",
        windir = f"{OUT}/{{arm}}/blocks/bs{{blocksize}}/windows",
    shell:
        r"""
        set -euo pipefail
        python "{params.script}" \
            --arm "{wildcards.arm}" \
            --block-vcf-dir "{params.windir}" \
            --popfile "{input.popfile}" \
            --sfs "{input.sfs}" \
            --simple-fit "{input.simple_fit}" \
            --complex-fit "{input.complex_fit}" \
            --out-json "{output.json}"
        """


# ===========================================================================
# STEP 3 -- OVERLAPPING windows -> LD stats -> aggregate -> SIMPLE fit (p0)
# ===========================================================================
rule overlap_window:
    input:
        vcf     = lambda wc: arm_vcf(wc.arm),
        popfile = POPFILE,
    output:
        vcf_gz = f"{OUT}/{{arm}}/overlap/windows/window_{{i}}.vcf.gz",
    params:
        out_dir = f"{OUT}/{{arm}}/overlap/windows",
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.out_dir}"
        python "{SNAKE_SCR}/split_vcf_windows.py" \
            --input-vcf "{input.vcf}" --popfile "{input.popfile}" \
            --out-dir "{params.out_dir}" \
            --window-size {OVERLAP_WINDOW} --num-windows {OVERLAP_NWIN} \
            --window-index {wildcards.i}
        """

rule overlap_ld_stats:
    input:
        vcf_gz = f"{OUT}/{{arm}}/overlap/windows/window_{{i}}.vcf.gz",
        gmap   = f"{OUT}/{{arm}}/genetic_map.txt",
    output:
        pkl = f"{OUT}/{{arm}}/overlap/LD_stats/LD_stats_window_{{i}}.pkl",
    resources:
        gpu = 1
    params:
        sim_dir = f"{OUT}/{{arm}}/overlap",
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.sim_dir}/LD_stats"
        python "{GODAMBE_SCR}/ld_stats_safe.py" \
            --sim-dir "{params.sim_dir}" --window-index {wildcards.i} \
            --config-file "{LD_CONFIG}" --r-bins "{R_BINS}" \
            --rec-map-file "{input.gmap}"
        """

# aggregate overlapping windows -> means.varcovs.pkl  (bootstrap_ld.py IS this)
rule aggregate_overlap:
    input:
        pkls = expand(f"{OUT}/{{{{arm}}}}/overlap/LD_stats/LD_stats_window_{{i}}.pkl",
                      i=OVERLAP_WINDOWS),
    output:
        mv = f"{OUT}/{{arm}}/overlap/means.varcovs.pkl",
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/bootstrap_ld.py" \
            --ld-stats-dir "{OUT}/{wildcards.arm}/overlap/LD_stats" \
            --out-dir "{OUT}/{wildcards.arm}/overlap"
        """

# 100 LHS starts, EACH ITS OWN JOB. {fit} selects the model (simple=null,
# complex=alt); the same rule fits either, writing to fit_{fit}/.
rule fit_one_start:
    input:
        mv = f"{OUT}/{{arm}}/overlap/means.varcovs.pkl",
    output:
        start = f"{OUT}/{{arm}}/fit_{{fit}}/start_{{opt}}.pkl",
    params:
        model = lambda wc: FIT_MODEL[wc.fit],
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/fit_one_start_ld.py" \
            --mv "{input.mv}" --opt-index {wildcards.opt} --n-opt {N_OPT} \
            --model {params.model} --out "{output.start}"
        """

# collect best start -> that model's MLE (null p0, or the alt fit)
rule collect_best_fit:
    input:
        starts = expand(f"{OUT}/{{{{arm}}}}/fit_{{{{fit}}}}/start_{{opt}}.pkl", opt=OPT_INDICES),
    output:
        fit = f"{OUT}/{{arm}}/fit_{{fit}}/best_fit.pkl",
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/collect_best_fit.py" \
            --starts {input.starts} --out "{output.fit}"
        """


# ===========================================================================
# STEP 4 + 5 -- NON-OVERLAPPING sweep (per block size), maximally parallel
# ===========================================================================

# 4a. tile the arm into non-overlapping blocks of size {blocksize}.
#     CHECKPOINT: the number of windows is only known at runtime (span // S).
checkpoint tile_nonoverlap:
    input:
        vcf     = lambda wc: arm_vcf(wc.arm),
        popfile = POPFILE,
    output:
        windir = directory(f"{OUT}/{{arm}}/sweep/bs{{blocksize}}/windows"),
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{output.windir}"
        # `bcftools query | head` trips SIGPIPE under pipefail; disable it here.
        set +o pipefail
        first=$(bcftools query -f '%POS\n' "{input.vcf}" | head -n1)
        last=$(bcftools query -f '%POS\n' "{input.vcf}" | tail -n1)
        set -o pipefail
        span=$((last - first + 1))
        n=$((span / {wildcards.blocksize}))
        if [ "$n" -lt 1 ]; then n=1; fi
        python "{SNAKE_SCR}/split_vcf_windows.py" \
            --input-vcf "{input.vcf}" --popfile "{input.popfile}" \
            --out-dir "{output.windir}" \
            --window-size {wildcards.blocksize} --num-windows "$n"
        """

# 4b. LD stats per non-overlapping tile (one job per window)
rule nonoverlap_ld_stats:
    input:
        vcf_gz = f"{OUT}/{{arm}}/sweep/bs{{blocksize}}/windows/window_{{i}}.vcf.gz",
        gmap   = f"{OUT}/{{arm}}/genetic_map.txt",
    output:
        pkl = f"{OUT}/{{arm}}/sweep/bs{{blocksize}}/LD_stats/LD_stats_window_{{i}}.pkl",
    resources:
        gpu = 1
    params:
        sim_dir = f"{OUT}/{{arm}}/sweep/bs{{blocksize}}",
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.sim_dir}/LD_stats"
        python "{GODAMBE_SCR}/ld_stats_safe.py" \
            --sim-dir "{params.sim_dir}" --window-index {wildcards.i} \
            --config-file "{LD_CONFIG}" --r-bins "{R_BINS}" \
            --rec-map-file "{input.gmap}"
        """

# gather the per-window LD stats after the tiling checkpoint resolves
def gather_ld_pkls(wildcards):
    ck = checkpoints.tile_nonoverlap.get(arm=wildcards.arm, blocksize=wildcards.blocksize)
    windir = ck.output.windir
    idxs = glob_wildcards(os.path.join(windir, "window_{i}.vcf.gz")).i
    pattern = OUT + "/{arm}/sweep/bs{blocksize}/LD_stats/LD_stats_window_{i}.pkl"
    return expand(pattern, arm=wildcards.arm, blocksize=wildcards.blocksize, i=idxs)

# 4c+5a. aggregate the tiles + compute J at p0
rule j_at_blocksize:
    input:
        pkls = gather_ld_pkls,
        fit  = f"{OUT}/{{arm}}/fit_simple/best_fit.pkl",
    output:
        j = f"{OUT}/{{arm}}/sweep/J_bs{{blocksize}}.pkl",
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/aggregate_and_J_ld.py" \
            --ld-stats-dir "{OUT}/{wildcards.arm}/sweep/bs{wildcards.blocksize}/LD_stats" \
            --null-fit "{input.fit}" --blocksize {wildcards.blocksize} \
            --r-bins "{R_BINS}" --out "{output.j}"
        """

# 5b. per-arm J-vs-blocklength plot
rule sweep_plot:
    input:
        js = lambda wc: expand(
            f"{OUT}/{wc.arm}/sweep/J_bs{{bs}}.pkl", bs=blocksizes_for(wc.arm)),
    output:
        png = f"{OUT}/{{arm}}/J_vs_blocklength.png",
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/plot_arm_sweep.py" \
            --js {input.js} --out "{output.png}" --arm "{wildcards.arm}"
        """


# ===========================================================================
# SFS (moments) identifiability check -- NOT in `rule all`, run explicitly:
#   snakemake -s godambe_correction_LRT/Snakefile --cores 1 \
#       godambe_correction_LRT/real_arms/Chr2L/sfs_fit_complex/fim_summary.json
# or `snakemake -s godambe_correction_LRT/Snakefile --cores N sfs_fim_all`
# ===========================================================================

SFS_OPT_INDICES = range(SFS_N_STARTS)

# each optimizer start is its own job (mirrors fit_one_start_ld.py on the LD side)
rule sfs_fit_one_start:
    input:
        sfs = f"{DROSO}/{{arm}}/unfolded.sfs.pkl",
    output:
        start = f"{OUT}/{{arm}}/sfs_fit_{{fit}}/starts/start_{{opt}}.pkl",
    params:
        cfg      = lambda wc: SFS_CFG[wc.fit],
        model    = lambda wc: FIT_MODEL[wc.fit],
        n_starts = SFS_N_STARTS,
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/sfs_fit_one_start.py" \
            --arm "{wildcards.arm}" --model {params.model} \
            --sfs "{input.sfs}" --config "{params.cfg}" \
            --opt-index {wildcards.opt} --n-starts {params.n_starts} \
            --out "{output.start}"
        """

# collect all starts -> best MLE -> slice profiles + FIM/cond(H) diagnostic
rule sfs_collect_fim:
    input:
        starts = expand(f"{OUT}/{{{{arm}}}}/sfs_fit_{{{{fit}}}}/starts/start_{{opt}}.pkl",
                         opt=SFS_OPT_INDICES),
        sfs = f"{DROSO}/{{arm}}/unfolded.sfs.pkl",
    output:
        fit = f"{OUT}/{{arm}}/sfs_fit_{{fit}}/best_fit.pkl",
        summ = f"{OUT}/{{arm}}/sfs_fit_{{fit}}/fim_summary.json",
    params:
        cfg     = lambda wc: SFS_CFG[wc.fit],
        model   = lambda wc: FIT_MODEL[wc.fit],
        out_dir = f"{OUT}/{{arm}}/sfs_fit_{{fit}}",
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/sfs_collect_and_fim.py" \
            --arm "{wildcards.arm}" --model {params.model} \
            --sfs "{input.sfs}" --config "{params.cfg}" \
            --starts {input.starts} --out-dir "{params.out_dir}"
        """

# ChrX excluded: no unfolded.sfs.pkl under real_data_analysis/data/drosophila/ChrX/ yet.
SFS_ARMS = ["Chr2L", "Chr2R", "Chr3L", "Chr3R"]

rule sfs_fim_all:
    input:
        expand(f"{OUT}/{{arm}}/sfs_fit_{{fit}}/fim_summary.json",
               arm=SFS_ARMS, fit=["simple", "complex"]),


# ===========================================================================
# Godambe-adjusted LRT for CO growth (per arm) -- NOT in `rule all`, run
# explicitly, e.g.:
#   snakemake -s godambe_correction_LRT/Snakefile --cores 8 \
#       godambe_correction_LRT/real_arms/Chr3L/godambe_lrt/block_sensitivity.csv
# or `snakemake -s godambe_correction_LRT/Snakefile --cores N godambe_lrt_all`
#
# Generalized from scripts/bootstrapping_for_LRT_Chr3L.py: reparameterizes CO
# growth as growth_CO = log(N_CO0/N_CO1) (null: growth_CO=0, i.e. N_CO0=N_CO1)
# so the test doesn't depend on N_CO0's separate identifiability from N_ANC --
# H comes from moments.Godambe.get_hess restricted to growth_CO at the
# null-embedded point; J comes from a block-bootstrap over this arm's own
# non-overlapping blocks. Swept across GODAMBE_GROWTH_BLOCK_SIZES_KB and
# reported once more at the arm's own LD-decay-validated block size (from
# rule validated_blocks) for a size that isn't arbitrarily chosen.
# ===========================================================================
rule godambe_lrt_growth:
    input:
        simple_fit       = f"{OUT}/{{arm}}/sfs_fit_simple/best_fit.pkl",
        complex_fit      = f"{OUT}/{{arm}}/sfs_fit_complex/best_fit.pkl",
        sfs              = f"{DROSO}/{{arm}}/unfolded.sfs.pkl",
        # NOTE: the haploid polarized VCF (ploidy=1, matches how unfolded.sfs.pkl
        # was built), NOT arm_vcf()'s diploidGT VCF used by the LD-side rules.
        vcf              = f"{DROSO}/{{arm}}/polarized.vcf.gz",
        popfile          = POPFILE,
        validated_blocks = f"{OUT}/{{arm}}/validated_blocks.bed",
    output:
        csv         = f"{OUT}/{{arm}}/godambe_lrt/block_sensitivity.csv",
        sensitivity = f"{OUT}/{{arm}}/godambe_lrt/block_sensitivity.png",
        j_plot      = f"{OUT}/{{arm}}/godambe_lrt/J_and_adjust_by_block_size.png",
        adjust_plot = f"{OUT}/{{arm}}/godambe_lrt/adjust_by_block_size.png",
        histograms  = expand(
            f"{OUT}/{{{{arm}}}}/godambe_lrt/J_bootstrap_hist_{{bs}}kb.png",
            bs=GODAMBE_GROWTH_BLOCK_SIZES_KB,
        ),
    params:
        script         = f"{GODAMBE_SCR}/godambe_lrt_growth.py",
        out_dir        = f"{OUT}/{{arm}}/godambe_lrt",
        cache_dir      = f"{DROSO}/chunk_spectra_cache/{{arm}}",
        block_sizes_kb = ",".join(str(b) for b in GODAMBE_GROWTH_BLOCK_SIZES_KB),
        num_boot_reps  = GODAMBE_GROWTH_NUM_BOOT_REPS,
    threads: 8
    shell:
        r"""
        set -euo pipefail
        python "{params.script}" \
            --arm {wildcards.arm} \
            --simple-fit "{input.simple_fit}" \
            --complex-fit "{input.complex_fit}" \
            --sfs "{input.sfs}" \
            --vcf "{input.vcf}" \
            --popfile "{input.popfile}" \
            --validated-blocks-bed "{input.validated_blocks}" \
            --out-dir "{params.out_dir}" \
            --cache-dir "{params.cache_dir}" \
            --max-workers {threads} \
            --num-boot-reps {params.num_boot_reps} \
            --block-sizes-kb "{params.block_sizes_kb}"
        """

rule godambe_lrt_all:
    input:
        expand(f"{OUT}/{{arm}}/godambe_lrt/block_sensitivity.csv", arm=SFS_ARMS),