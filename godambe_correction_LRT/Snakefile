# godambe_correction_LRT/Snakefile
#
# Per-arm Moments-LD + Godambe-J block-size sweep for the real Drosophila arms,
# PLUS the validated-block-size / uncorrelated-distance histogram analysis
# (the productionized version of building_bridges.py). No high-recombination
# masking anywhere -- everything runs on the raw, unmasked arm VCFs.
# Maximally parallelized: every LHS optimization and every window is its own job.
# Run from the repo ROOT:
#     snakemake -s godambe_correction_LRT/Snakefile --cores N --resources gpu=G <target>
#
# Per arm:
#   1. genetic_map                                       (Comeron xlsx -> cM map)
#   2. validated_blocks: per-300kb-chunk, per-population (CO/FR) LD-decay ->
#        floor -> crossing distance -> CO/FR histograms + a validated block size,
#        directly validated against the EXACT literal blocks used downstream
#   3. OVERLAPPING windows -> fit SIMPLE model -> p0
#        fit is 100 LHS starts, EACH ITS OWN JOB (fit_one_start) -> collect_best_fit
#   4. NON-OVERLAPPING windows (per block size), embed p0 in the complex model
#        tiling is a checkpoint; each window's LD stats is its own job
#   5. J vs block size -> per-arm plot
#
# rule all currently targets ONLY the validated_blocks histogram (step 2) for
# ACTIVE_ARMS -- the moments/LD-Godambe sweep (steps 3-5) still works, just
# request its target explicitly (see rule sweep_plot).

import os
from pathlib import Path

# ---------------------------------------------------------------------------
# Paths (relative to repo root)
# ---------------------------------------------------------------------------
DROSO         = "real_data_analysis/data/drosophila"
COMERON_XLSX  = f"{DROSO}/recombination_maps/Comeron_100kb_R5_R6.xlsx"
POPFILE       = f"{DROSO}/popfile.txt"

# Optional per-arm centromere/telomere trim, mirroring the main repo Snakefile's
# real_data_analysis.trim_region (config_files/experiment_config_split_migration_growth_both.json).
# Tag-directory naming isn't uniform -- Chr3L was produced as a single-arm trim
# run, ChrX only exists under the main pipeline's all-5-arm trim tag -- so we
# point directly at each arm's actual on-disk trimmed/polarized/diploid-recoded
# VCF rather than deriving the path from a formula.
TRIM_REGION = {
    "Chr2L": (844225, 19946732),
    "Chr2R": (6063980, 20322335),
    "Chr3L": (447386, 18392988),
    "ChrX":  (1036552, 20902578),
}
_FIVE_ARM_TRIM_DIR = (
    "real_data_analysis/data/drosophila_trim_Chr2L-844225-19946732_Chr2R-6063980-20322335"
    "_Chr3L-447386-18392988_Chr3R-7940899-27237549_ChrX-1036552-20902578"
)
TRIMMED_VCF = {
    "Chr2L": f"{_FIVE_ARM_TRIM_DIR}/Chr2L/polarized.diploidGT.vcf.gz",
    "Chr2R": f"{_FIVE_ARM_TRIM_DIR}/Chr2R/polarized.diploidGT.vcf.gz",
    "Chr3L": f"{_FIVE_ARM_TRIM_DIR}/Chr3L/polarized.diploidGT.vcf.gz",
    "ChrX":  f"{_FIVE_ARM_TRIM_DIR}/ChrX/polarized.diploidGT.vcf.gz",
}
# Same trimmed-data directories also hold the haploid VCF (polarized.vcf.gz,
# ploidy=1, used by the SFS side) and unfolded.sfs.pkl -- point the SFS-side
# rules (sfs_fit_one_start, sfs_collect_fim, godambe_lrt_growth) at these too,
# so they're consistent with the trimmed VCF the LD side already uses instead
# of silently mixing trimmed LD data with untrimmed SFS data.
TRIMMED_HAPLOID_VCF = {
    "Chr2L": f"{_FIVE_ARM_TRIM_DIR}/Chr2L/polarized.vcf.gz",
    "Chr2R": f"{_FIVE_ARM_TRIM_DIR}/Chr2R/polarized.vcf.gz",
    "Chr3L": f"{_FIVE_ARM_TRIM_DIR}/Chr3L/polarized.vcf.gz",
    "ChrX":  f"{_FIVE_ARM_TRIM_DIR}/ChrX/polarized.vcf.gz",
}
TRIMMED_SFS = {
    "Chr2L": f"{_FIVE_ARM_TRIM_DIR}/Chr2L/unfolded.sfs.pkl",
    "Chr2R": f"{_FIVE_ARM_TRIM_DIR}/Chr2R/unfolded.sfs.pkl",
    "Chr3L": f"{_FIVE_ARM_TRIM_DIR}/Chr3L/unfolded.sfs.pkl",
    "ChrX":  f"{_FIVE_ARM_TRIM_DIR}/ChrX/unfolded.sfs.pkl",
}

def arm_vcf(arm):
    if arm in TRIMMED_VCF:
        return TRIMMED_VCF[arm]
    return f"{DROSO}/{arm}/polarized.diploidGT.vcf.gz"

def arm_haploid_vcf(arm):
    if arm in TRIMMED_HAPLOID_VCF:
        return TRIMMED_HAPLOID_VCF[arm]
    return f"{DROSO}/{arm}/polarized.vcf.gz"

def arm_sfs(arm):
    if arm in TRIMMED_SFS:
        return TRIMMED_SFS[arm]
    return f"{DROSO}/{arm}/unfolded.sfs.pkl"

OUT           = "godambe_correction_LRT/real_arms"
GODAMBE_SCR   = "godambe_correction_LRT/snakemake_scripts"
GODAMBE_SRC   = "godambe_correction_LRT/src"
SNAKE_SCR     = "snakemake_scripts"
LD_CONFIG     = "godambe_correction_LRT/ld/ld_config.json"   # num_samples + use_gpu_ld

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------
ARMS = ["Chr2L", "Chr2R", "Chr3L", "Chr3R"]

# Per-arm NON-overlapping block sizes (bp) for the J sweep. Chr2L extended down
# to 20 kb (~ the containment floor for these r_bins) to look for a small-block
# plateau. Other arms start at 50 kb.
_SWEEP = [20_000, 30_000, 40_000, 50_000, 100_000, 200_000, 500_000]
BLOCKSIZES = {arm: list(_SWEEP) for arm in ARMS}

R_BINS = "0,1e-6,2e-6,5e-6,1e-5,2e-5"            # trimmed r_bins

OVERLAP_WINDOW  = 200_000                         # step 3 overlapping windows
# Per-arm window count for ~contiguous (no gap, negligible overlap) tiling of
# each arm's (trimmed) span at 200kb -- span differs per arm so this can't be
# a single global number: Chr3L trimmed span ~17.95 Mb -> 90; ChrX trimmed
# span ~19.87 Mb -> 100.
OVERLAP_NWIN = {
    "Chr3L": 90,
    "ChrX":  100,
}

# Wide-range r_bins for the momentsLD real-data model fit. Tried narrowing
# these to bracket just the r* implied by each arm's SFS-fit T (~1e-6,
# CO's own split/growth timing) -- that made things WORSE (more bound
# railing, not less), because the wider range apparently also constrains
# OTHER parameters (esp. N_FR0/N_FR1, FR's own separate two-epoch history,
# which isn't necessarily at the same time depth as CO's event). Reverted:
# max edge 1e-3 -> ~690kb at recombination_rate=1.45e-9/bp.
MOMENTSLD_WIDE_R_BINS = (
    "0,1e-06,1.58489e-06,2.51189e-06,3.98107e-06,6.30957e-06,1e-05,"
    "1.58489e-05,2.51189e-05,3.98107e-05,6.30957e-05,0.0001,0.000158489,"
    "0.000251189,0.000398107,0.000630957,0.001"
)
# Non-overlapping window size for the above -- must be >= the widest r_bin's
# physical distance (~690kb) so that bin still has real SNP pairs; same for
# every arm since it's set by the r_bins, not by any one arm's validated
# decorrelation distance (which is far smaller than 690kb regardless).
MOMENTSLD_WINDOW_BP_BY_ARM = {
    "Chr2L": 700_000,
    "Chr3L": 700_000,
    "ChrX":  700_000,
    "Chr2R": 700_000,
}

# Optional pruning of step-3 windows before LD-stats (mirrors the main
# Snakefile's prune_mode="count"): caps each window at PRUNE_KEEP SNPs,
# random subsample when denser, copied through unchanged when already
# sparser. Purely a compute-cost cap -- LD-stats math is unaffected, and
# downstream (aggregate_overlap, fit_one_start, ...) doesn't need to know.
PRUNE_MODE = "count"                              # "off" | "count"
PRUNE_KEEP = 5000
PRUNE_TAG  = f"n{PRUNE_KEEP}"

N_OPT       = 100                                 # LHS starts for the fit
OPT_INDICES = range(N_OPT)

# The same fit rules serve both models, selected by the {fit} wildcard:
#   fit_simple/  -> null  (split_migration_growth,      CO constant, p0 for J)
#   fit_complex/ -> alt   (split_migration_growth_both, CO grows)
#   fit_co_const/-> null  (co_const_at_anc,  CO tied to N_ANC -- identifiable)
#   fit_co_grow/ -> alt   (co_grow_from_anc, CO grows from N_ANC -- identifiable)
FIT_MODEL = {
    "simple":   "split_migration_growth",         # original null (free N_CO)
    "complex":  "split_migration_growth_both",    # original alt  (free N_CO0 & N_CO1 -- unidentifiable)
    "co_const": "co_const_at_anc",                 # identifiable null (no free CO-specific param)
    "co_grow":  "co_grow_from_anc",                # identifiable alt  (only N_CO1 free)
}

# Per-arm SFS (moments) identifiability check -- mirrors the LD-side Godambe
# conditioning diagnostic (run_lrt.py cond(H)), but for the theta-profiled
# scaled-ratio real-data moments fit (src.moments_inference_real). Reuses the
# same fitting engine as the root Snakefile's rule infer_moments_real; this is
# NOT a duplicate demographic-model definition, just a per-arm entry point +
# the FIM/railing diagnostic that doesn't exist yet for the real-data branch.
SFS_CFG = {
    "simple":  "config_files/experiment_config_split_migration_growth.json",
    "complex": "config_files/experiment_config_split_migration_growth_both.json",
}
SFS_N_STARTS = 100

# Godambe-adjusted LRT for CO growth (snakemake_scripts/godambe_lrt_growth.py), generalized
# from the original Chr3L-only bootstrapping_for_LRT_Chr3L.py so any arm in
# SFS_ARMS can be requested directly. ~100 kb is the LD-justified recommendation
# from bootstrap_window_size.py (set by the slow-decaying Chr2R-FR curve in the
# pooled analysis); the arm-specific, LD-decay-validated block size from
# rule validated_blocks is reported alongside this sweep, not instead of it.
GODAMBE_GROWTH_BLOCK_SIZES_KB = [50, 75, 100, 150, 200, 300, 500]
GODAMBE_GROWTH_NUM_BOOT_REPS = 10_000

ACTIVE_ARMS = ["Chr3L"]                           # restricted to Chr3L for now

# Pooled-arm support for the Godambe LRT (godambe_lrt_growth_pooled below):
# a second, additive "arm" identifier that combines multiple real arms into
# one SFS + one block-bootstrap, without touching any existing per-arm
# results (everything lands under real_arms/{POOLED_TAG}/, a new sibling
# directory of real_arms/Chr3L/ etc.).
POOLED_ARMS = ["Chr2L", "Chr3L"]
POOLED_TAG = "_".join(POOLED_ARMS)        # "Chr2L_Chr3L" -- real_arms/{arm}/ path shape
POOLED_ARMS_DASH = "-".join(POOLED_ARMS)  # "Chr2L-Chr3L" -- matches bootstrapping_for_LRT.py's cache-file naming

wildcard_constraints:
    arm         = r"Chr[0-9A-Za-z]+(_Chr[0-9A-Za-z]+)*",
    fit         = r"simple|complex|co_const|co_grow",
    opt         = r"\d+",
    i           = r"\d+",
    blocksize   = r"\d+",
    chunk_index = r"\d+",
    vbchunk     = r"\d+",


def blocksizes_for(arm):
    return BLOCKSIZES[arm]


# ---------------------------------------------------------------------------
# Targets
# ---------------------------------------------------------------------------
rule all:
    input:
        expand(f"{OUT}/{{arm}}/validated_blocks_histogram.png", arm=ACTIVE_ARMS),


# ===========================================================================
# STEP 1 -- genetic map
# ===========================================================================
rule genetic_map:
    input:
        xlsx = COMERON_XLSX,
    output:
        gmap = f"{OUT}/{{arm}}/genetic_map.txt",
    shell:
        r"""
        set -euo pipefail
        python "{SNAKE_SCR}/build_genetic_map.py" \
            --xlsx "{input.xlsx}" --chrom "{wildcards.arm}" --out "{output.gmap}"
        """

# ===========================================================================
# STEP 2 -- VALIDATED BLOCK SIZE / uncorrelated-distance histograms
# (productionized building_bridges.py). Per-population (CO/FR), per-300kb-chunk
# LD-decay -> floor -> crossing (uncorrelated) distance; combines across chunks
# into a validated block size and saves the CO/FR crossing-distance histograms
# (see compute_validated_blocks.py). Validates that exact, literal block list
# directly (validate_blocks_direct), not a re-derived local approximation.
# Runs on the RAW, UNMASKED arm VCF -- its whole job is to discover the
# usable/unusable boundary itself, so it can't be pre-restricted to a region.
# Part of `rule all`.
# ===========================================================================
# validated_blocks Stage 1 (per-chunk floor/crossing-distance) is
# parallelized across chunks: chunk_bounds enumerates them cheaply (VCF span
# only, no r2), process_one_chunk does the actual per-chunk pairwise-r2 work
# as its own job (so ~80 chunks run concurrently, bounded by --resources
# gpu=N, instead of one long sequential loop), and validated_blocks
# aggregates all of them (Stage 2 percentile-combine + Stage 3 validate).
VALIDATED_BLOCKS_CHUNK_SIZE      = 300_000
VALIDATED_BLOCKS_FLOOR_CUTOFF_BP = 20_000
VALIDATED_BLOCKS_TOLERANCE       = 1.10
VALIDATED_BLOCKS_NBINS           = 60
VALIDATED_BLOCKS_PERCENTILE      = 99
VALIDATED_BLOCKS_GROUP_SIZE      = 4
# Cap on SNP pairs fed into a chunk's per-bin median (random subsample above
# this) -- a dense 300kb chunk can have tens of millions of pairs, far more
# than needed for a stable median across 60 bins, and the per-bin binning
# loop's cost scales with pair count.
VALIDATED_BLOCKS_MAX_PAIRS       = 2_000_000

checkpoint chunk_bounds:
    input:
        vcf = lambda wc: arm_vcf(wc.arm),
    output:
        chunk_dir = directory(f"{OUT}/{{arm}}/validated_blocks_chunks"),
    params:
        chunk_size      = VALIDATED_BLOCKS_CHUNK_SIZE,
        floor_cutoff_bp = VALIDATED_BLOCKS_FLOOR_CUTOFF_BP,
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{output.chunk_dir}"
        python "{GODAMBE_SCR}/chunk_bounds.py" \
            --vcf "{input.vcf}" \
            --chunk-size {params.chunk_size} --floor-cutoff-bp {params.floor_cutoff_bp} \
            --out-dir "{output.chunk_dir}"
        """

rule process_one_chunk:
    input:
        vcf     = lambda wc: arm_vcf(wc.arm),
        popfile = POPFILE,
        bounds  = f"{OUT}/{{arm}}/validated_blocks_chunks/chunk_{{vbchunk}}.json",
    output:
        result = f"{OUT}/{{arm}}/validated_blocks_chunks/result_{{vbchunk}}.json",
    threads: 1
    params:
        floor_cutoff_bp = VALIDATED_BLOCKS_FLOOR_CUTOFF_BP,
        tolerance       = VALIDATED_BLOCKS_TOLERANCE,
        n_bins          = VALIDATED_BLOCKS_NBINS,
        max_pairs       = VALIDATED_BLOCKS_MAX_PAIRS,
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/process_one_chunk.py" \
            --vcf "{input.vcf}" --popfile "{input.popfile}" --arm "{wildcards.arm}" \
            --chunk-bounds-file "{input.bounds}" \
            --floor-cutoff-bp {params.floor_cutoff_bp} --tolerance {params.tolerance} \
            --n-bins {params.n_bins} --max-pairs {params.max_pairs} \
            --out "{output.result}"
        """

def gather_chunk_results(wildcards):
    ck = checkpoints.chunk_bounds.get(arm=wildcards.arm)
    chunk_dir = ck.output.chunk_dir
    idxs = glob_wildcards(os.path.join(chunk_dir, "chunk_{vbchunk}.json")).vbchunk
    pattern = OUT + "/{arm}/validated_blocks_chunks/result_{vbchunk}.json"
    return expand(pattern, arm=wildcards.arm, vbchunk=idxs)

rule validated_blocks:
    input:
        vcf           = lambda wc: arm_vcf(wc.arm),
        popfile       = POPFILE,
        chunk_results = gather_chunk_results,
    output:
        bed            = f"{OUT}/{{arm}}/validated_blocks.bed",
        report         = f"{OUT}/{{arm}}/validated_blocks_report.json",
        histogram      = f"{OUT}/{{arm}}/validated_blocks_histogram.png",
        crossr2_check  = f"{OUT}/{{arm}}/validated_blocks_crossr2_check.png",
    params:
        script              = f"{GODAMBE_SCR}/compute_validated_blocks.py",
        tolerance           = VALIDATED_BLOCKS_TOLERANCE,
        percentile          = VALIDATED_BLOCKS_PERCENTILE,
        validate_group_size = VALIDATED_BLOCKS_GROUP_SIZE,
    shell:
        r"""
        set -euo pipefail
        python "{params.script}" \
            --vcf "{input.vcf}" --popfile "{input.popfile}" --arm "{wildcards.arm}" \
            --chunk-results {input.chunk_results} \
            --tolerance {params.tolerance} --percentile {params.percentile} \
            --validate-group-size {params.validate_group_size} \
            --out-bed "{output.bed}" --out-report "{output.report}" \
            --out-histogram "{output.histogram}" \
            --out-crossr2-check "{output.crossr2_check}"
        """

# Visual check: does correlation actually drop off at the validated block
# boundaries? Renders the raw r2 matrix (black & white, CO vs FR) for ONE
# 300kb chunk -- the same chunk unit compute_validated_blocks.py used to
# compute that chunk's floor/crossing distance -- with the block-tiling
# boundaries drawn as dashed lines. Not part of `rule all`; NOTE: this
# snakemake version has a logging bug that raises a spurious "not enough
# values to unpack" in the default (non-verbose) log level for this rule --
# always pass --verbose when requesting it, e.g.:
#   snakemake -s godambe_correction_LRT/Snakefile --cores N --resources gpu=G \
#       --verbose godambe_correction_LRT/real_arms/Chr3L/ld_chunk_zoom_c0.png
rule ld_chunk_zoom:
    input:
        vcf   = lambda wc: arm_vcf(wc.arm),
        popfile = POPFILE,
        bed   = f"{OUT}/{{arm}}/validated_blocks.bed",
    output:
        png = f"{OUT}/{{arm}}/ld_chunk_zoom_c{{chunk_index}}.png",
    resources:
        gpu = 1
    params:
        script = f"{GODAMBE_SCR}/plot_ld_blocks_zoom.py",
    shell:
        r"""
        set -euo pipefail
        python "{params.script}" \
            --vcf "{input.vcf}" --popfile "{input.popfile}" --arm "{wildcards.arm}" \
            --blocks-bed "{input.bed}" \
            --chunk-index {wildcards.chunk_index} \
            --out-png "{output.png}"
        """


# Tile the raw haploid polarized VCF into non-overlapping blocks of a given
# physical size (bp), for block-bootstrap resampling (mirrors `checkpoint
# tile_nonoverlap` below, which does the same thing for the diploid VCF used
# by the moments.LD/J side; this one uses the haploid VCF used by the
# LD-decay/SFS side instead).
# CHECKPOINT: the number of blocks is only known at runtime (span // blocksize).
# Request a size explicitly, e.g.:
#   snakemake -s godambe_correction_LRT/Snakefile --cores N \
#       godambe_correction_LRT/real_arms/Chr3L/blocks/bs20000/windows
checkpoint tile_polarized_blocks:
    input:
        vcf     = lambda wc: arm_haploid_vcf(wc.arm),
        popfile = POPFILE,
    output:
        windir = directory(f"{OUT}/{{arm}}/blocks/bs{{blocksize}}/windows"),
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{output.windir}"
        # `bcftools query | head` trips SIGPIPE under pipefail; disable it here.
        set +o pipefail
        first=$(bcftools query -f '%POS\n' "{input.vcf}" | head -n1)
        last=$(bcftools query -f '%POS\n' "{input.vcf}" | tail -n1)
        set -o pipefail
        span=$((last - first + 1))
        n=$((span / {wildcards.blocksize}))
        if [ "$n" -lt 1 ]; then n=1; fi
        python "{SNAKE_SCR}/split_vcf_windows.py" \
            --input-vcf "{input.vcf}" --popfile "{input.popfile}" \
            --out-dir "{output.windir}" \
            --window-size {wildcards.blocksize} --num-windows "$n"
        """

# gather the block VCFs after the tiling checkpoint resolves (mirrors
# gather_ld_pkls below, for the moments.LD/J side's own checkpoint)
def gather_block_vcfs(wildcards):
    ck = checkpoints.tile_polarized_blocks.get(arm=wildcards.arm, blocksize=wildcards.blocksize)
    windir = ck.output.windir
    idxs = glob_wildcards(os.path.join(windir, "window_{i}.vcf.gz")).i
    pattern = OUT + "/{arm}/blocks/bs{blocksize}/windows/window_{i}.vcf.gz"
    return expand(pattern, arm=wildcards.arm, blocksize=wildcards.blocksize, i=idxs)

# Raw Godambe H and J for the CO-growth test, at one arm + block size, using
# moments.Godambe's own internals (see compute_H_J.py) rather than a
# hand-rolled score/J loop. Not part of `rule all`; request explicitly, e.g.:
#   snakemake -s godambe_correction_LRT/Snakefile --cores N \
#       godambe_correction_LRT/real_arms/Chr3L/blocks/bs20000/H_J.json
rule compute_H_J:
    input:
        block_vcfs  = gather_block_vcfs,
        sfs         = lambda wc: arm_sfs(wc.arm),
        simple_fit  = f"{OUT}/{{arm}}/sfs_fit_simple/best_fit.pkl",
        complex_fit = f"{OUT}/{{arm}}/sfs_fit_complex/best_fit.pkl",
        popfile     = POPFILE,
    output:
        json = f"{OUT}/{{arm}}/blocks/bs{{blocksize}}/H_J.json",
    params:
        script = f"{GODAMBE_SCR}/compute_H_J.py",
        windir = f"{OUT}/{{arm}}/blocks/bs{{blocksize}}/windows",
    shell:
        r"""
        set -euo pipefail
        python "{params.script}" \
            --arm "{wildcards.arm}" \
            --block-vcf-dir "{params.windir}" \
            --popfile "{input.popfile}" \
            --sfs "{input.sfs}" \
            --simple-fit "{input.simple_fit}" \
            --complex-fit "{input.complex_fit}" \
            --out-json "{output.json}"
        """


# ===========================================================================
# STEP 2b -- momentsLD real-data model-fit windows: NON-overlapping, wide
# r_bins (~690kb reach, to see recent-history LD signal), one job per window.
# Distinct from STEP 3's overlapping p0-fit windows and STEP 4's block-size
# sweep -- this is windowing for the actual momentsLD parameter fit/model
# comparison. Request explicitly, e.g.:
#   snakemake -s godambe_correction_LRT/Snakefile --cores N --resources gpu=1 \
#       godambe_correction_LRT/real_arms/Chr3L/momentsld/LD_stats/LD_stats_window_0.pkl
# ===========================================================================
checkpoint momentsld_windows:
    input:
        vcf     = lambda wc: arm_vcf(wc.arm),
        popfile = POPFILE,
    output:
        windir = directory(f"{OUT}/{{arm}}/momentsld/windows"),
    params:
        window_bp = lambda wc: MOMENTSLD_WINDOW_BP_BY_ARM[wc.arm],
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{output.windir}"
        # `bcftools query | head` trips SIGPIPE under pipefail; disable it here.
        set +o pipefail
        first=$(bcftools query -f '%POS\n' "{input.vcf}" | head -n1)
        last=$(bcftools query -f '%POS\n' "{input.vcf}" | tail -n1)
        set -o pipefail
        span=$((last - first + 1))
        n=$((span / {params.window_bp}))
        if [ "$n" -lt 1 ]; then n=1; fi
        python "{SNAKE_SCR}/split_vcf_windows.py" \
            --input-vcf "{input.vcf}" --popfile "{input.popfile}" \
            --out-dir "{output.windir}" \
            --window-size {params.window_bp} --num-windows "$n"
        """

def gather_momentsld_pkls(wildcards):
    ck = checkpoints.momentsld_windows.get(arm=wildcards.arm)
    windir = ck.output.windir
    idxs = glob_wildcards(os.path.join(windir, "window_{i}.vcf.gz")).i
    pattern = OUT + "/{arm}/momentsld/LD_stats/LD_stats_window_{i}.pkl"
    return expand(pattern, arm=wildcards.arm, i=idxs)

rule momentsld_ld_stats:
    input:
        vcf_gz = f"{OUT}/{{arm}}/momentsld/windows/window_{{i}}.vcf.gz",
        gmap   = f"{OUT}/{{arm}}/genetic_map.txt",
    output:
        pkl = f"{OUT}/{{arm}}/momentsld/LD_stats/LD_stats_window_{{i}}.pkl",
    resources:
        gpu = 1
    params:
        sim_dir = f"{OUT}/{{arm}}/momentsld",
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.sim_dir}/LD_stats"
        python "{GODAMBE_SCR}/ld_stats_safe.py" \
            --sim-dir "{params.sim_dir}" --window-index {wildcards.i} \
            --config-file "{LD_CONFIG}" --r-bins "{MOMENTSLD_WIDE_R_BINS}" \
            --rec-map-file "{input.gmap}"
        """

# Convenience target: all per-window LD stat pkls for one arm, e.g.
#   snakemake -s godambe_correction_LRT/Snakefile --cores N --resources gpu=1 \
#       godambe_correction_LRT/real_arms/Chr3L/momentsld/LD_stats/all.done
rule momentsld_ld_stats_all:
    input:
        pkls = gather_momentsld_pkls,
    output:
        touch(f"{OUT}/{{arm}}/momentsld/LD_stats/all.done"),

# aggregate the 25 non-overlapping windows -> means.varcovs.pkl + bootstrap_sets.pkl
# (bootstrap_ld.py resamples WINDOWS with replacement -- valid here since,
# unlike the old 1Mb/25-window scheme, these windows are genuinely non-overlapping).
rule momentsld_aggregate:
    input:
        pkls = gather_momentsld_pkls,
    output:
        mv    = f"{OUT}/{{arm}}/momentsld/means.varcovs.pkl",
        boots = f"{OUT}/{{arm}}/momentsld/bootstrap_sets.pkl",
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/bootstrap_ld.py" \
            --ld-stats-dir "{OUT}/{wildcards.arm}/momentsld/LD_stats" \
            --out-dir "{OUT}/{wildcards.arm}/momentsld"
        """

# ---------------------------------------------------------------------------
# Pooled-arm momentsLD analysis: combine ALREADY-COMPUTED per-arm LD_stats
# (each arm's own windows, non-overlapping within that arm; windows from
# different arms can't overlap each other either, since they're on different
# chromosomes entirely) into one shared pool via symlinks, then reuse the
# generic momentsld_diagonal_varcov/momentsld_fit_one_start/
# momentsld_collect_best_fit rules UNCHANGED, since they're already
# parameterized generically. Tag deliberately does NOT start with "Chr" so it
# can't collide with the real-arm `arm` wildcard_constraints regex above.
# ---------------------------------------------------------------------------
MOMENTSLD_POOLED_ARM_SETS = {
    "Pooled_Chr2R_Chr3L": ["Chr2R", "Chr3L"],
}

def gather_momentsld_pkls_for_arm(arm):
    ck = checkpoints.momentsld_windows.get(arm=arm)
    windir = ck.output.windir
    idxs = glob_wildcards(os.path.join(windir, "window_{i}.vcf.gz")).i
    pattern = OUT + "/{arm}/momentsld/LD_stats/LD_stats_window_{i}.pkl"
    return expand(pattern, arm=arm, i=idxs)

def gather_momentsld_pkls_pooled(wildcards):
    pkls = []
    for member in MOMENTSLD_POOLED_ARM_SETS[wildcards.pooled]:
        pkls += gather_momentsld_pkls_for_arm(member)
    return pkls

rule momentsld_pool_ld_stats:
    input:
        pkls = gather_momentsld_pkls_pooled,
    output:
        directory(f"{OUT}/{{pooled}}/momentsld/LD_stats"),
    wildcard_constraints:
        pooled = "|".join(MOMENTSLD_POOLED_ARM_SETS.keys()),
    run:
        import pathlib
        outdir = pathlib.Path(output[0])
        outdir.mkdir(parents=True, exist_ok=True)
        idx = 0
        for member in MOMENTSLD_POOLED_ARM_SETS[wildcards.pooled]:
            src_dir = pathlib.Path(f"{OUT}/{member}/momentsld/LD_stats")
            for f in sorted(src_dir.glob("LD_stats_window_*.pkl"),
                             key=lambda p: int(p.stem.rsplit("_", 1)[-1])):
                dest = outdir / f"LD_stats_window_{idx}.pkl"
                if dest.exists() or dest.is_symlink():
                    dest.unlink()
                dest.symlink_to(f.resolve())
                idx += 1

rule momentsld_aggregate_pooled:
    input:
        ld_stats_dir = f"{OUT}/{{pooled}}/momentsld/LD_stats",
    output:
        mv    = f"{OUT}/{{pooled}}/momentsld/means.varcovs.pkl",
        boots = f"{OUT}/{{pooled}}/momentsld/bootstrap_sets.pkl",
    wildcard_constraints:
        pooled = "|".join(MOMENTSLD_POOLED_ARM_SETS.keys()),
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/bootstrap_ld.py" \
            --ld-stats-dir "{input.ld_stats_dir}" \
            --out-dir "{OUT}/{wildcards.pooled}/momentsld"
        """

# Diagonal-only covariance (standing choice for this analysis, not a one-off
# patch -- see diagonalize_varcov.py docstring for what this trades away).
rule momentsld_diagonal_varcov:
    input:
        mv = f"{OUT}/{{arm}}/momentsld/means.varcovs.pkl",
    output:
        mv_diag = f"{OUT}/{{arm}}/momentsld/means.varcovs.diagonly.pkl",
    wildcard_constraints:
        # widened locally (not in the global block) so this one rule also
        # accepts pooled tags, without making momentsld_aggregate/_windows/
        # etc. ambiguous for real-arm-only paths.
        arm = r"Chr[0-9A-Za-z]+(_Chr[0-9A-Za-z]+)*|" + "|".join(MOMENTSLD_POOLED_ARM_SETS.keys()),
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/diagonalize_varcov.py" --mv "{input.mv}" --out "{output.mv_diag}"
        """

# Fit null (CO constant, fit_simple/) / alt (CO grows, fit_complex/) to the
# diagonal-only covariance -- same {fit}->FIT_MODEL mapping, same N_OPT=100
# LHS starts EACH ITS OWN JOB, same collect_best_fit.py as the overlap-window
# p0 fit above. (Reuses FIT_MODEL: "simple"->split_migration_growth,
# "complex"->split_migration_growth_both -- the unidentifiable diagnostic
# pair per fit_simple_ld.py's docstring, not co_grow_from_anc.)
rule momentsld_fit_one_start:
    input:
        mv = f"{OUT}/{{arm}}/momentsld/means.varcovs.diagonly.pkl",
    output:
        start = f"{OUT}/{{arm}}/momentsld/fit_{{fit}}/start_{{opt}}/result.pkl",
        log   = f"{OUT}/{{arm}}/momentsld/fit_{{fit}}/start_{{opt}}/optimization.txt",
    params:
        model = lambda wc: FIT_MODEL[wc.fit],
    wildcard_constraints:
        arm = r"Chr[0-9A-Za-z]+(_Chr[0-9A-Za-z]+)*|" + "|".join(MOMENTSLD_POOLED_ARM_SETS.keys()),
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/fit_one_start_ld.py" \
            --mv "{input.mv}" --opt-index {wildcards.opt} --n-opt {N_OPT} \
            --model {params.model} --out "{output.start}" --log "{output.log}"
        """

rule momentsld_collect_best_fit:
    input:
        starts = expand(f"{OUT}/{{{{arm}}}}/momentsld/fit_{{{{fit}}}}/start_{{opt}}/result.pkl", opt=OPT_INDICES),
    output:
        fit = f"{OUT}/{{arm}}/momentsld/fit_{{fit}}/best_fit.pkl",
    wildcard_constraints:
        arm = r"Chr[0-9A-Za-z]+(_Chr[0-9A-Za-z]+)*|" + "|".join(MOMENTSLD_POOLED_ARM_SETS.keys()),
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/collect_best_fit.py" \
            --starts {input.starts} --out "{output.fit}"
        """


# ===========================================================================
# STEP 3 -- OVERLAPPING windows -> LD stats -> aggregate -> SIMPLE fit (p0)
# ===========================================================================
rule overlap_window:
    input:
        vcf     = lambda wc: arm_vcf(wc.arm),
        popfile = POPFILE,
    output:
        vcf_gz = f"{OUT}/{{arm}}/overlap/windows/window_{{i}}.vcf.gz",
    params:
        out_dir = f"{OUT}/{{arm}}/overlap/windows",
        nwin    = lambda wc: OVERLAP_NWIN[wc.arm],
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.out_dir}"
        python "{SNAKE_SCR}/split_vcf_windows.py" \
            --input-vcf "{input.vcf}" --popfile "{input.popfile}" \
            --out-dir "{params.out_dir}" \
            --window-size {OVERLAP_WINDOW} --num-windows {params.nwin} \
            --window-index {wildcards.i}
        """

rule prune_overlap_window:
    input:
        vcf_gz = f"{OUT}/{{arm}}/overlap/windows/window_{{i}}.vcf.gz",
    output:
        pruned_vcf = temp(f"{OUT}/{{arm}}/overlap/pruning/{PRUNE_TAG}/windows/window_{{i}}.vcf.gz"),
    params:
        pruning_dir = f"{OUT}/{{arm}}/overlap/pruning",
    threads: 1
    shell:
        r"""
        set -euo pipefail
        python "src/prune_vcf.py" \
            --vcf "{input.vcf_gz}" \
            --out-dir "{params.pruning_dir}" \
            --keep-counts {PRUNE_KEEP} \
            --no-unpruned \
            --workers 1
        """

if PRUNE_MODE != "off":
    rule overlap_ld_stats:
        input:
            vcf_gz = f"{OUT}/{{arm}}/overlap/pruning/{PRUNE_TAG}/windows/window_{{i}}.vcf.gz",
            gmap   = f"{OUT}/{{arm}}/genetic_map.txt",
        output:
            pkl = f"{OUT}/{{arm}}/overlap/LD_stats/LD_stats_window_{{i}}.pkl",
        resources:
            gpu = 1
        params:
            sim_dir = f"{OUT}/{{arm}}/overlap/pruning/{PRUNE_TAG}",
        shell:
            r"""
            set -euo pipefail
            mkdir -p "{params.sim_dir}/LD_stats"
            python "{GODAMBE_SCR}/ld_stats_safe.py" \
                --sim-dir "{params.sim_dir}" --window-index {wildcards.i} \
                --config-file "{LD_CONFIG}" --r-bins "{R_BINS}" \
                --rec-map-file "{input.gmap}"

            mv "{params.sim_dir}/LD_stats/LD_stats_window_{wildcards.i}.pkl" "{output.pkl}"
            """
else:
    rule overlap_ld_stats:
        input:
            vcf_gz = f"{OUT}/{{arm}}/overlap/windows/window_{{i}}.vcf.gz",
            gmap   = f"{OUT}/{{arm}}/genetic_map.txt",
        output:
            pkl = f"{OUT}/{{arm}}/overlap/LD_stats/LD_stats_window_{{i}}.pkl",
        resources:
            gpu = 1
        params:
            sim_dir = f"{OUT}/{{arm}}/overlap",
        shell:
            r"""
            set -euo pipefail
            mkdir -p "{params.sim_dir}/LD_stats"
            python "{GODAMBE_SCR}/ld_stats_safe.py" \
                --sim-dir "{params.sim_dir}" --window-index {wildcards.i} \
                --config-file "{LD_CONFIG}" --r-bins "{R_BINS}" \
                --rec-map-file "{input.gmap}"
            """

# aggregate overlapping windows -> means.varcovs.pkl  (bootstrap_ld.py IS this)
rule aggregate_overlap:
    input:
        pkls = lambda wc: expand(f"{OUT}/{wc.arm}/overlap/LD_stats/LD_stats_window_{{i}}.pkl",
                                  i=range(OVERLAP_NWIN[wc.arm])),
    output:
        mv = f"{OUT}/{{arm}}/overlap/means.varcovs.pkl",
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/bootstrap_ld.py" \
            --ld-stats-dir "{OUT}/{wildcards.arm}/overlap/LD_stats" \
            --out-dir "{OUT}/{wildcards.arm}/overlap"
        """

# 100 LHS starts, EACH ITS OWN JOB. {fit} selects the model (simple=null,
# complex=alt); the same rule fits either, writing to fit_{fit}/.
rule fit_one_start:
    input:
        mv = f"{OUT}/{{arm}}/overlap/means.varcovs.pkl",
    output:
        start = f"{OUT}/{{arm}}/fit_{{fit}}/start_{{opt}}.pkl",
    params:
        model = lambda wc: FIT_MODEL[wc.fit],
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/fit_one_start_ld.py" \
            --mv "{input.mv}" --opt-index {wildcards.opt} --n-opt {N_OPT} \
            --model {params.model} --out "{output.start}"
        """

# collect best start -> that model's MLE (null p0, or the alt fit)
rule collect_best_fit:
    input:
        starts = expand(f"{OUT}/{{{{arm}}}}/fit_{{{{fit}}}}/start_{{opt}}.pkl", opt=OPT_INDICES),
    output:
        fit = f"{OUT}/{{arm}}/fit_{{fit}}/best_fit.pkl",
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/collect_best_fit.py" \
            --starts {input.starts} --out "{output.fit}"
        """


# ===========================================================================
# STEP 4 + 5 -- NON-OVERLAPPING sweep (per block size), maximally parallel
# ===========================================================================

# 4a. tile the arm into non-overlapping blocks of size {blocksize}.
#     CHECKPOINT: the number of windows is only known at runtime (span // S).
checkpoint tile_nonoverlap:
    input:
        vcf     = lambda wc: arm_vcf(wc.arm),
        popfile = POPFILE,
    output:
        windir = directory(f"{OUT}/{{arm}}/sweep/bs{{blocksize}}/windows"),
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{output.windir}"
        # `bcftools query | head` trips SIGPIPE under pipefail; disable it here.
        set +o pipefail
        first=$(bcftools query -f '%POS\n' "{input.vcf}" | head -n1)
        last=$(bcftools query -f '%POS\n' "{input.vcf}" | tail -n1)
        set -o pipefail
        span=$((last - first + 1))
        n=$((span / {wildcards.blocksize}))
        if [ "$n" -lt 1 ]; then n=1; fi
        python "{SNAKE_SCR}/split_vcf_windows.py" \
            --input-vcf "{input.vcf}" --popfile "{input.popfile}" \
            --out-dir "{output.windir}" \
            --window-size {wildcards.blocksize} --num-windows "$n"
        """

# 4b. LD stats per non-overlapping tile (one job per window)
rule nonoverlap_ld_stats:
    input:
        vcf_gz = f"{OUT}/{{arm}}/sweep/bs{{blocksize}}/windows/window_{{i}}.vcf.gz",
        gmap   = f"{OUT}/{{arm}}/genetic_map.txt",
    output:
        pkl = f"{OUT}/{{arm}}/sweep/bs{{blocksize}}/LD_stats/LD_stats_window_{{i}}.pkl",
    resources:
        gpu = 1
    params:
        sim_dir = f"{OUT}/{{arm}}/sweep/bs{{blocksize}}",
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.sim_dir}/LD_stats"
        python "{GODAMBE_SCR}/ld_stats_safe.py" \
            --sim-dir "{params.sim_dir}" --window-index {wildcards.i} \
            --config-file "{LD_CONFIG}" --r-bins "{R_BINS}" \
            --rec-map-file "{input.gmap}"
        """

# gather the per-window LD stats after the tiling checkpoint resolves
def gather_ld_pkls(wildcards):
    ck = checkpoints.tile_nonoverlap.get(arm=wildcards.arm, blocksize=wildcards.blocksize)
    windir = ck.output.windir
    idxs = glob_wildcards(os.path.join(windir, "window_{i}.vcf.gz")).i
    pattern = OUT + "/{arm}/sweep/bs{blocksize}/LD_stats/LD_stats_window_{i}.pkl"
    return expand(pattern, arm=wildcards.arm, blocksize=wildcards.blocksize, i=idxs)

# 4c+5a. aggregate the tiles + compute J at p0
rule j_at_blocksize:
    input:
        pkls = gather_ld_pkls,
        fit  = f"{OUT}/{{arm}}/fit_simple/best_fit.pkl",
    output:
        j = f"{OUT}/{{arm}}/sweep/J_bs{{blocksize}}.pkl",
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/aggregate_and_J_ld.py" \
            --ld-stats-dir "{OUT}/{wildcards.arm}/sweep/bs{wildcards.blocksize}/LD_stats" \
            --null-fit "{input.fit}" --blocksize {wildcards.blocksize} \
            --r-bins "{R_BINS}" --out "{output.j}"
        """

# 5b. per-arm J-vs-blocklength plot
rule sweep_plot:
    input:
        js = lambda wc: expand(
            f"{OUT}/{wc.arm}/sweep/J_bs{{bs}}.pkl", bs=blocksizes_for(wc.arm)),
    output:
        png = f"{OUT}/{{arm}}/J_vs_blocklength.png",
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/plot_arm_sweep.py" \
            --js {input.js} --out "{output.png}" --arm "{wildcards.arm}"
        """


# ===========================================================================
# SFS (moments) identifiability check -- NOT in `rule all`, run explicitly:
#   snakemake -s godambe_correction_LRT/Snakefile --cores 1 \
#       godambe_correction_LRT/real_arms/Chr2L/sfs_fit_complex/fim_summary.json
# or `snakemake -s godambe_correction_LRT/Snakefile --cores N sfs_fim_all`
# ===========================================================================

SFS_OPT_INDICES = range(SFS_N_STARTS)

# Materializes a pooled Chr2L+Chr3L unfolded SFS at the same path shape
# (DROSO/{arm}/unfolded.sfs.pkl) real per-arm SFS files use, so the generic
# sfs_fit_one_start/sfs_collect_fim rules below run UNCHANGED with
# wildcards.arm == POOLED_TAG -- no rule-body changes needed for the SFS side.
rule combine_pooled_sfs:
    input:
        sfs = expand(f"{DROSO}/{{arm}}/unfolded.sfs.pkl", arm=POOLED_ARMS),
    output:
        sfs = f"{DROSO}/{POOLED_TAG}/unfolded.sfs.pkl",
    params:
        script = "snakemake_scripts/combine_sfs.py",
    shell:
        r"""
        set -euo pipefail
        python "{params.script}" --in-sfs {input.sfs} --output-sfs "{output.sfs}"
        """

# each optimizer start is its own job (mirrors fit_one_start_ld.py on the LD side)
rule sfs_fit_one_start:
    input:
        sfs = lambda wc: arm_sfs(wc.arm),
    output:
        start = f"{OUT}/{{arm}}/sfs_fit_{{fit}}/starts/start_{{opt}}.pkl",
    params:
        cfg      = lambda wc: SFS_CFG[wc.fit],
        model    = lambda wc: FIT_MODEL[wc.fit],
        n_starts = SFS_N_STARTS,
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/sfs_fit_one_start.py" \
            --arm "{wildcards.arm}" --model {params.model} \
            --sfs "{input.sfs}" --config "{params.cfg}" \
            --opt-index {wildcards.opt} --n-starts {params.n_starts} \
            --out "{output.start}"
        """

# collect all starts -> best MLE -> slice profiles + FIM/cond(H) diagnostic
rule sfs_collect_fim:
    input:
        starts = expand(f"{OUT}/{{{{arm}}}}/sfs_fit_{{{{fit}}}}/starts/start_{{opt}}.pkl",
                         opt=SFS_OPT_INDICES),
        sfs = lambda wc: arm_sfs(wc.arm),
    output:
        fit = f"{OUT}/{{arm}}/sfs_fit_{{fit}}/best_fit.pkl",
        summ = f"{OUT}/{{arm}}/sfs_fit_{{fit}}/fim_summary.json",
    params:
        cfg     = lambda wc: SFS_CFG[wc.fit],
        model   = lambda wc: FIT_MODEL[wc.fit],
        out_dir = f"{OUT}/{{arm}}/sfs_fit_{{fit}}",
    shell:
        r"""
        set -euo pipefail
        python "{GODAMBE_SCR}/sfs_collect_and_fim.py" \
            --arm "{wildcards.arm}" --model {params.model} \
            --sfs "{input.sfs}" --config "{params.cfg}" \
            --starts {input.starts} --out-dir "{params.out_dir}"
        """

# ChrX excluded: no unfolded.sfs.pkl under real_data_analysis/data/drosophila/ChrX/ yet.
SFS_ARMS = ["Chr2L", "Chr2R", "Chr3L", "Chr3R"]

rule sfs_fim_all:
    input:
        expand(f"{OUT}/{{arm}}/sfs_fit_{{fit}}/fim_summary.json",
               arm=SFS_ARMS, fit=["simple", "complex"]),


# ===========================================================================
# Godambe-adjusted LRT for CO growth (per arm) -- NOT in `rule all`, run
# explicitly, e.g.:
#   snakemake -s godambe_correction_LRT/Snakefile --cores 8 \
#       godambe_correction_LRT/real_arms/Chr3L/godambe_lrt/block_sensitivity.csv
# or `snakemake -s godambe_correction_LRT/Snakefile --cores N godambe_lrt_all`
#
# Generalized from archive/bootstrapping_for_LRT_Chr3L.py: reparameterizes CO
# growth as growth_CO = log(N_CO0/N_CO1) (null: growth_CO=0, i.e. N_CO0=N_CO1)
# so the test doesn't depend on N_CO0's separate identifiability from N_ANC --
# H comes from moments.Godambe.get_hess restricted to growth_CO at the
# null-embedded point; J comes from a block-bootstrap over this arm's own
# non-overlapping blocks. Swept across GODAMBE_GROWTH_BLOCK_SIZES_KB and
# reported once more at the arm's own LD-decay-validated block size (from
# rule validated_blocks) for a size that isn't arbitrarily chosen.
# ===========================================================================
rule godambe_lrt_growth:
    input:
        simple_fit       = f"{OUT}/{{arm}}/sfs_fit_simple/best_fit.pkl",
        complex_fit      = f"{OUT}/{{arm}}/sfs_fit_complex/best_fit.pkl",
        sfs              = lambda wc: arm_sfs(wc.arm),
        # NOTE: the haploid polarized VCF (ploidy=1, matches how unfolded.sfs.pkl
        # was built), NOT arm_vcf()'s diploidGT VCF used by the LD-side rules.
        vcf              = lambda wc: arm_haploid_vcf(wc.arm),
        popfile          = POPFILE,
        validated_blocks = f"{OUT}/{{arm}}/validated_blocks.bed",
    output:
        csv         = f"{OUT}/{{arm}}/godambe_lrt/block_sensitivity.csv",
        sensitivity = f"{OUT}/{{arm}}/godambe_lrt/block_sensitivity.png",
        j_plot      = f"{OUT}/{{arm}}/godambe_lrt/J_and_adjust_by_block_size.png",
        adjust_plot = f"{OUT}/{{arm}}/godambe_lrt/adjust_by_block_size.png",
        histograms  = expand(
            f"{OUT}/{{{{arm}}}}/godambe_lrt/J_bootstrap_hist_{{bs}}kb.png",
            bs=GODAMBE_GROWTH_BLOCK_SIZES_KB,
        ),
    params:
        script         = f"{GODAMBE_SCR}/godambe_lrt_growth.py",
        out_dir        = f"{OUT}/{{arm}}/godambe_lrt",
        cache_dir      = f"{DROSO}/chunk_spectra_cache/{{arm}}",
        block_sizes_kb = ",".join(str(b) for b in GODAMBE_GROWTH_BLOCK_SIZES_KB),
        num_boot_reps  = GODAMBE_GROWTH_NUM_BOOT_REPS,
    threads: 8
    shell:
        r"""
        set -euo pipefail
        python "{params.script}" \
            --arm {wildcards.arm} \
            --simple-fit "{input.simple_fit}" \
            --complex-fit "{input.complex_fit}" \
            --sfs "{input.sfs}" \
            --vcf "{input.vcf}" \
            --popfile "{input.popfile}" \
            --validated-blocks-bed "{input.validated_blocks}" \
            --out-dir "{params.out_dir}" \
            --cache-dir "{params.cache_dir}" \
            --max-workers {threads} \
            --num-boot-reps {params.num_boot_reps} \
            --block-sizes-kb "{params.block_sizes_kb}"
        """

# Pooled Chr2L+Chr3L variant of godambe_lrt_growth above. Everything lands
# under real_arms/{POOLED_TAG}/ -- a new sibling directory, never touching
# real_arms/Chr3L/ or any other existing per-arm results. Reuses
# godambe_lrt_growth.py's now-generalized multi-arm support (--arm/--vcf
# nargs="+"); cache_dir is deliberately bootstrapping_for_LRT.py's own
# chunk_spectra_multiarm/ dir so the already-computed pooled block spectra
# (50/75/100/150/200/300/500 kb) are reused instead of recomputed. No
# --validated-blocks-bed (dropped for the pooled case, see script docstring).
rule godambe_lrt_growth_pooled:
    input:
        simple_fit  = f"{OUT}/{POOLED_TAG}/sfs_fit_simple/best_fit.pkl",
        complex_fit = f"{OUT}/{POOLED_TAG}/sfs_fit_complex/best_fit.pkl",
        sfs         = f"{DROSO}/{POOLED_TAG}/unfolded.sfs.pkl",
        vcfs        = expand(f"{DROSO}/{{arm}}/polarized.vcf.gz", arm=POOLED_ARMS),
        popfile     = POPFILE,
    output:
        csv         = f"{OUT}/{POOLED_TAG}/godambe_lrt/block_sensitivity.csv",
        sensitivity = f"{OUT}/{POOLED_TAG}/godambe_lrt/block_sensitivity.png",
        j_plot      = f"{OUT}/{POOLED_TAG}/godambe_lrt/J_and_adjust_by_block_size.png",
        adjust_plot = f"{OUT}/{POOLED_TAG}/godambe_lrt/adjust_by_block_size.png",
        histograms  = expand(
            f"{OUT}/{POOLED_TAG}/godambe_lrt/J_bootstrap_hist_{{bs}}kb.png",
            bs=GODAMBE_GROWTH_BLOCK_SIZES_KB,
        ),
    params:
        script         = f"{GODAMBE_SCR}/godambe_lrt_growth.py",
        out_dir        = f"{OUT}/{POOLED_TAG}/godambe_lrt",
        cache_dir      = f"{DROSO}/chunk_spectra_multiarm",
        arms           = " ".join(POOLED_ARMS),
        block_sizes_kb = ",".join(str(b) for b in GODAMBE_GROWTH_BLOCK_SIZES_KB),
        num_boot_reps  = GODAMBE_GROWTH_NUM_BOOT_REPS,
    threads: 8
    shell:
        r"""
        set -euo pipefail
        python "{params.script}" \
            --arm {params.arms} \
            --simple-fit "{input.simple_fit}" \
            --complex-fit "{input.complex_fit}" \
            --sfs "{input.sfs}" \
            --vcf {input.vcfs} \
            --popfile "{input.popfile}" \
            --out-dir "{params.out_dir}" \
            --cache-dir "{params.cache_dir}" \
            --max-workers {threads} \
            --num-boot-reps {params.num_boot_reps} \
            --block-sizes-kb "{params.block_sizes_kb}"
        """

rule godambe_lrt_all:
    input:
        expand(f"{OUT}/{{arm}}/godambe_lrt/block_sensitivity.csv", arm=SFS_ARMS),